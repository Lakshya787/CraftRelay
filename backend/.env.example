# ──────────────────────────────────────────────────────────────────────────────
# CraftRelay Backend — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=CraftRelay
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://craftrelay_user:CHANGE_ME@localhost:5432/craftrelay_dev

# Sync URL for Alembic migrations (uses psycopg2)
DATABASE_SYNC_URL=postgresql+psycopg2://craftrelay_user:CHANGE_ME@localhost:5432/craftrelay_dev

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# ─── JWT / Auth (placeholder — not implemented in Part 1) ─────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Service (Optional LLM Integration) ──────────────────────────────────
# Set AI_PROVIDER to 'gemini', 'openai', 'mock', or 'none' (default: none)
AI_PROVIDER=none
AI_ENABLED=false
# Gemini: get key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Or generic AI_API_KEY
AI_API_KEY=
# Model name (e.g. gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini)
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=12.0
AI_BASE_URL=


# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG    # DEBUG | INFO | WARNING | ERROR | CRITICAL
