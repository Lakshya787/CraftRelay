# ──────────────────────────────────────────────────────────────────────────────
# CraftRelay Mobile — Environment Variable Template
# Copy to .env and fill in real values.
# Variables MUST be prefixed with EXPO_PUBLIC_ to be accessible in client code.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── API ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1   # Android emulator → host
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1  # iOS simulator / web

# ─── App Metadata ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=CraftRelay
EXPO_PUBLIC_APP_ENV=development
