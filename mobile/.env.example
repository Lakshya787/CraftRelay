# ──────────────────────────────────────────────────────────────────────────────
# CraftRelay Mobile — Environment Variable Template
# Copy to .env and fill in real values.
# Variables MUST be prefixed with EXPO_PUBLIC_ to be accessible in client code.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── API ──────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-host.example/api/v1

# ─── App Metadata ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=CraftRelay
EXPO_PUBLIC_APP_ENV=development
